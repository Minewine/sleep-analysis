<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy posture (docs/PRIVACY_AND_REGULATORY.md §2): this app processes sleep audio and
     health data entirely on-device. Nothing may leave the device via Google cloud backup or a
     device-to-device migration — every storage domain is excluded from both. Belt-and-braces
     alongside android:allowBackup="false" on <application>. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
