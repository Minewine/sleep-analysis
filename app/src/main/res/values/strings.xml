    <!-- Onboarding / disclaimer (docs/PRIVACY_AND_REGULATORY.md §5.1) -->
    <string name="onboarding_title">Before you start</string>
    <string name="onboarding_disclaimer">
        SleepAnalysis is a personal wellness and research tool — not a medical device.\n\n
        It does not diagnose, treat, or prevent any disease, including sleep apnea. It estimates
        simple measures like snoring from microphone sound; these estimates can be wrong and are
        not a substitute for a sleep study (polysomnography) or advice from a qualified clinician.\n\n
        If you regularly experience loud snoring, witnessed breathing pauses, gasping during sleep,
        or excessive daytime sleepiness, speak to a doctor.
    </string>
    <string name="onboarding_what_we_record">What this app records</string>
    <string name="onboarding_what_body">
        • Microphone audio is processed on this device only — nothing is uploaded (the app has no
        internet permission at all).\n\n
        • Full-night audio is never saved. Short clips (a few seconds) are kept for detected events
        so you can verify them, and are deleted automatically after your retention period.\n\n
        • All data stays in this app\'s private storage. You can delete a single night or everything
        at any time.
    </string>
    <string name="onboarding_placement_title">Placement matters</string>
    <string name="onboarding_placement_body">
        Put the phone on your nightstand, roughly 0.5–1 m from your head, with the microphone
        unobstructed. Keep it plugged in. Results vary with distance and background noise.
    </string>
    <string name="onboarding_accept">I understand — accept</string>
    <string name="onboarding_mic_rationale">The microphone is used only while a recording session is running, and the ongoing notification shows you when it is active.</string>

